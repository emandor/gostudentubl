TIMEZONE=Asia/Jakarta
INTEGRATION_NETWORK=homelab_integration

USERNAME=your_username
PASSWORD=your_password

LOGIN_URL=https://elearning.example.com/login/index.php
COURSES_URL=https://elearning.example.com/my/
ATTENDANCE_LIST_URL=https://elearning.example.com/mod/attendance/index.php
ASSIGNMENT_LIST_URL=https://elearning.example.com/mod/assign/index.php
QUIZ_LIST_URL=https://elearning.example.com/mod/quiz/index.php
ASSIGNMENT_DETAIL_URL=https://elearning.example.com/mod/assign/view.php
QUIZ_DETAIL_URL=https://elearning.example.com/mod/quiz/view.php
ATTENDANCE_URL=https://elearning.example.com/mod/attendance/view.php
ATTENDANCE_FORM_URL=https://elearning.example.com/mod/attendance/attendance.php

# Periode mode
# auto   : allow current month + next month automatically (recommended)
# manual : read values from ALLOWED_PERIODES (comma separated)
# legacy : keep strict CURRENT_PERIODE behavior
PERIODE_MODE=auto
ALLOWED_PERIODES=0226,0326
MAX_COURSES_PER_RUN=0

# Legacy fallback, used when PERIODE_MODE=legacy
CURRENT_PERIODE=0226

# Cross-project Docker endpoint on shared external network
WA_ENDPOINT=http://wa-bot-notif-api:5000/send
WA_TOKEN=Bearer your_token
WA_ME=your_private_group_or_chat_id
WA_GROUP=your_target_group_id
NOTIFICATION_DB_PATH=notifications.db
NOTIFICATION_BATCH_LIMIT=100
NOTIFICATION_RETENTION_DAYS=30
DETAIL_FETCH_ENABLED=true
DETAIL_FETCH_LIMIT=10

OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514
SUGGESTION_ENABLED=false
SUGGESTION_LIMIT=5

# Draft solver (AI-powered draft generation)
DRAFT_ENABLED=true
DRAFT_SOLVER=openrouter-with-copilot-fallback
DRAFT_LIMIT=3
DRAFT_TMUX_SESSION=copilot-solver

# Operational safety & reporting
RUN_LOCK_ENABLED=true
RUN_LOCK_TTL_MINUTES=15
DAILY_SUMMARY_ENABLED=true
CRON_DAILY_SUMMARY=30 21 * * *

CRON_WEEKDAY=1 8,12,13,14,19 * * 1-5
CRON_WEEKEND=0 8,9,11,14,16 * * 6

CONCURRENCY=4
RATE_PER_SEC=1
RATE_BURST=2
REQUEST_TIMEOUT_SEC=15
DRY_RUN=false

# Detail page fetching
DETAIL_FETCH_ENABLED=true
DETAIL_FETCH_LIMIT=10

# AI Suggestion System (via OpenRouter)
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514
SUGGESTION_ENABLED=false

# Course material corpus + answer review
MATERIAL_SYNC_ENABLED=true
MATERIAL_SYNC_LIMIT=5
MATERIAL_CACHE_DIR=materials
MATERIAL_MAX_FILE_MB=50

# PDF answer artifacts
PDF_GENERATION_ENABLED=true
PDF_CACHE_DIR=submissions
PDF_TEMPLATE_NAME=ubl_default
PDF_STUDENT_NAME=Aris Kurniawan
PDF_STUDENT_NIM=2311510438
CHROMIUM_PATH=chromium

# Assignment submission safety gate
# Real upload remains gated; approved PDFs are recorded for deadline-window submission handling.
SUBMISSION_ENABLED=false
SUBMISSION_AUTO_APPROVED_ONLY=true
SUBMISSION_DEADLINE_WINDOW_HOURS=2
